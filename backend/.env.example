# ============================================================
# Pharma System - Backend Environment Variables (Example)
# ============================================================
# انسخ هذا الملف إلى .env ثم عدّل القيم.
# لا تضع هذا الملف (.env) في Git أبداً.
# ============================================================

# ------------------------------------------------------------
# 1) Server
# ------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ------------------------------------------------------------
# 2) Database (MongoDB Atlas)
# ------------------------------------------------------------
# ⚠️ استبدل <user> و <password> و <cluster> و <db> ببياناتك الفعلية
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ------------------------------------------------------------
# 3) JWT (Access + Refresh)
# ------------------------------------------------------------
# ⚠️ استخدم نصوصاً عشوائية طويلة (64 حرفاً على الأقل) في الإنتاج
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars_long_random_string_here
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars_long_random_string_here
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# 4) Password Hashing
# ------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# 5) CORS
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# 6) Rate Limiting
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------
# 7) Email (Ethereal - للاختبار)
# ------------------------------------------------------------
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Pharma System <noreply@pharma-system.local>"

# ------------------------------------------------------------
# 8) Frontend URL
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# 9) Session / Idle Timeout
# ------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30

# ------------------------------------------------------------
# 10) Audit Log
# ------------------------------------------------------------
AUDIT_LOG_TTL_DAYS=365

# ------------------------------------------------------------
# 11) Backup (✅ v10.0 جديد)
# ------------------------------------------------------------
# مسار مجلد النسخ الاحتياطية التلقائية (يومية).
# على Windows: مسار مطلق مثل E:\Backups\Pharma\daily
# على Linux/Mac: مسار مطلق مثل /var/backups/pharma/daily
# ⚠️ يجب أن يكون المجلد موجوداً أو قابلاً للإنشاء (mkdir -p)
BACKUP_DIR=E:\Backups\Pharma\daily